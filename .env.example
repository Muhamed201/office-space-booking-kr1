POSTGRES_DB=office_booking
POSTGRES_USER=office
POSTGRES_PASSWORD=
POSTGRES_PORT=55432

APP_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:55432/office_booking
SPRING_DATASOURCE_USERNAME=office
SPRING_DATASOURCE_PASSWORD=

# Ключ Base64 из случайных 32 байт или больше.
JWT_SECRET_BASE64=
JWT_ISSUER=office-booking
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PERMANENT_DELETE_ENABLED=false
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
