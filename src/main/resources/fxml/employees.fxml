<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.officebooking.fx.controller.EmployeesController"
      styleClass="page" spacing="10">
    <Label text="Сотрудники" styleClass="title-label"/>

    <HBox spacing="8" styleClass="toolbar">
        <TextField fx:id="searchField" promptText="Поиск: ФИО, email, отдел" prefWidth="320"/>
        <Button text="Обновить" onAction="#onRefresh"/>
    </HBox>

    <TableView fx:id="employeeTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" text="ФИО" prefWidth="230"/>
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="220"/>
            <TableColumn fx:id="departmentColumn" text="Отдел" prefWidth="140"/>
            <TableColumn fx:id="positionColumn" text="Должность" prefWidth="140"/>
            <TableColumn fx:id="hireDateColumn" text="Принят" prefWidth="100"/>
            <TableColumn fx:id="roleColumn" text="Роль" prefWidth="120"/>
            <TableColumn fx:id="blockedColumn" text="Заблокирован" prefWidth="110"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox spacing="8" styleClass="toolbar">
        <Button fx:id="addButton" text="Добавить" styleClass="button-primary" onAction="#onAdd"/>
        <Button fx:id="editButton" text="Изменить" onAction="#onEdit"/>
        <Button fx:id="blockButton" text="Заблокировать" onAction="#onToggleBlocked"/>
        <Button fx:id="deleteButton" text="Удалить" styleClass="button-danger" onAction="#onDelete"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel" styleClass="status-label"/>
    </HBox>
</VBox>
