<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.officebooking.fx.controller.WorkspacesController"
      styleClass="page" spacing="10">
    <Label text="Рабочие места" styleClass="title-label"/>

    <HBox spacing="8" styleClass="toolbar">
        <Button text="Обновить" onAction="#onRefresh"/>
    </HBox>

    <TableView fx:id="workspaceTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="codeColumn" text="Код" prefWidth="110"/>
            <TableColumn fx:id="floorColumn" text="Этаж" prefWidth="70"/>
            <TableColumn fx:id="typeColumn" text="Тип" prefWidth="160"/>
            <TableColumn fx:id="statusColumn" text="Статус" prefWidth="150"/>
            <TableColumn fx:id="monitorColumn" text="Монитор" prefWidth="90"/>
            <TableColumn fx:id="capacityColumn" text="Вместимость" prefWidth="110"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox spacing="8" styleClass="toolbar">
        <Button fx:id="addButton" text="Добавить" styleClass="button-primary" onAction="#onAdd"/>
        <Button fx:id="editButton" text="Изменить" onAction="#onEdit"/>
        <Button fx:id="statusButton" text="Сменить статус" onAction="#onChangeStatus"/>
        <Button fx:id="deleteButton" text="Удалить" styleClass="button-danger" onAction="#onDelete"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel" styleClass="status-label"/>
    </HBox>
</VBox>
