<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.officebooking.fx.controller.StatisticsController"
            fitToWidth="true" styleClass="page-scroll">
    <VBox styleClass="page" spacing="14">
        <Label text="Статистика бронирований" styleClass="title-label"/>

        <HBox spacing="8" styleClass="toolbar">
            <Label text="Период для показателя «Броней за период»:" styleClass="field-label"/>
            <DatePicker fx:id="fromPicker" promptText="с" prefWidth="140"/>
            <DatePicker fx:id="toPicker" promptText="по" prefWidth="140"/>
            <Button text="Рассчитать" styleClass="button-primary" onAction="#onCalculate"/>
            <Button text="Сбросить период" onAction="#onResetPeriod"/>
        </HBox>
        <Label fx:id="errorLabel" styleClass="error" wrapText="true"/>

        <FlowPane hgap="12" vgap="12">
            <VBox styleClass="tile"><Label text="Всего броней" styleClass="tile-caption"/><Label fx:id="totalLabel" styleClass="tile-value"/></VBox>
            <VBox styleClass="tile"><Label text="Броней за период" styleClass="tile-caption"/><Label fx:id="periodLabel" styleClass="tile-value"/></VBox>
            <VBox styleClass="tile"><Label text="Доля неявок" styleClass="tile-caption"/><Label fx:id="noShowLabel" styleClass="tile-value"/></VBox>
            <VBox styleClass="tile"><Label text="Средняя длительность" styleClass="tile-caption"/><Label fx:id="avgLabel" styleClass="tile-value"/></VBox>
            <VBox styleClass="tile"><Label text="Минимальная длительность" styleClass="tile-caption"/><Label fx:id="minLabel" styleClass="tile-value"/></VBox>
            <VBox styleClass="tile"><Label text="Максимальная длительность" styleClass="tile-caption"/><Label fx:id="maxLabel" styleClass="tile-value"/></VBox>
            <VBox styleClass="tile"><Label text="Сотрудников" styleClass="tile-caption"/><Label fx:id="employeesLabel" styleClass="tile-value"/></VBox>
        </FlowPane>

        <HBox spacing="16">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Брони по статусам" styleClass="section-label"/>
                <PieChart fx:id="statusChart" legendSide="BOTTOM" prefHeight="300"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Брони по типам мест" styleClass="section-label"/>
                <PieChart fx:id="typeChart" legendSide="BOTTOM" prefHeight="300"/>
            </VBox>
        </HBox>

        <HBox spacing="16">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Самые востребованные места" styleClass="section-label"/>
                <TableView fx:id="topWorkspacesTable" prefHeight="200">
                    <columns>
                        <TableColumn fx:id="workspaceNameColumn" text="Место"/>
                        <TableColumn fx:id="workspaceCountColumn" text="Броней" maxWidth="120"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Самые активные сотрудники" styleClass="section-label"/>
                <TableView fx:id="topEmployeesTable" prefHeight="200">
                    <columns>
                        <TableColumn fx:id="employeeNameColumn" text="Сотрудник"/>
                        <TableColumn fx:id="employeeCountColumn" text="Броней" maxWidth="120"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
