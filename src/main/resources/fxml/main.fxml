<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.officebooking.fx.controller.MainController">
    <top>
        <HBox spacing="10" styleClass="user-bar">
            <Label text="Учёт офисных рабочих мест" styleClass="section-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" styleClass="user-label"/>
            <Button text="Сменить пользователя" onAction="#onLogout"/>
        </HBox>
    </top>
    <center>
        <TabPane styleClass="main-tabs" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Брони">
                    <content>
                        <fx:include source="bookings.fxml"/>
                    </content>
                </Tab>
                <Tab text="Сотрудники">
                    <content>
                        <fx:include source="employees.fxml"/>
                    </content>
                </Tab>
                <Tab text="Рабочие места">
                    <content>
                        <fx:include source="workspaces.fxml"/>
                    </content>
                </Tab>
                <Tab text="Статистика">
                    <content>
                        <fx:include source="statistics.fxml"/>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
