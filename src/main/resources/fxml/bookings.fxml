<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.officebooking.fx.controller.BookingsController"
      styleClass="page" spacing="10">
    <Label text="Бронирования рабочих мест" styleClass="title-label"/>

    <FlowPane hgap="8" vgap="8" styleClass="toolbar">
        <TextField fx:id="searchField" promptText="Поиск: сотрудник, email, место, цель" prefWidth="320"/>
        <ComboBox fx:id="statusCombo" prefWidth="160"/>
        <ComboBox fx:id="typeCombo" prefWidth="170"/>
        <ComboBox fx:id="floorCombo" prefWidth="130"/>
        <HBox spacing="6" styleClass="toolbar">
            <Label text="Период:" styleClass="field-label"/>
            <DatePicker fx:id="dateFromPicker" promptText="с" prefWidth="130"/>
            <DatePicker fx:id="dateToPicker" promptText="по" prefWidth="130"/>
        </HBox>
        <HBox spacing="6" styleClass="toolbar">
            <Label text="Сортировка:" styleClass="field-label"/>
            <ComboBox fx:id="sortCombo" prefWidth="150"/>
            <CheckBox fx:id="ascCheck" text="по возрастанию"/>
        </HBox>
        <HBox spacing="8">
            <Button text="Сбросить" onAction="#onReset"/>
            <Button text="Обновить" onAction="#onRefresh"/>
        </HBox>
    </FlowPane>

    <TableView fx:id="bookingTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="№" prefWidth="50" minWidth="40"/>
            <TableColumn fx:id="employeeColumn" text="Сотрудник" prefWidth="210"/>
            <TableColumn fx:id="workspaceColumn" text="Место" prefWidth="90"/>
            <TableColumn fx:id="typeColumn" text="Тип" prefWidth="130"/>
            <TableColumn fx:id="floorColumn" text="Этаж" prefWidth="55"/>
            <TableColumn fx:id="startColumn" text="Начало" prefWidth="130"/>
            <TableColumn fx:id="endColumn" text="Конец" prefWidth="130"/>
            <TableColumn fx:id="statusColumn" text="Статус" prefWidth="100"/>
            <TableColumn fx:id="attendeesColumn" text="Участников" prefWidth="90"/>
            <TableColumn fx:id="purposeColumn" text="Цель" prefWidth="220"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox spacing="8" styleClass="toolbar">
        <FlowPane hgap="8" vgap="8" HBox.hgrow="ALWAYS" styleClass="toolbar">
            <Button text="Добавить" styleClass="button-primary" onAction="#onAdd"/>
            <Button fx:id="editButton" text="Изменить" onAction="#onEdit"/>
            <Button fx:id="cancelBookingButton" text="Отменить бронь" onAction="#onCancelBooking"/>
            <Button fx:id="completeButton" text="Завершить" onAction="#onComplete"/>
            <Button fx:id="noShowButton" text="Неявка" onAction="#onNoShow"/>
            <Button fx:id="deleteButton" text="Удалить" styleClass="button-danger" onAction="#onDelete"/>
        </FlowPane>
        <Label fx:id="statusLabel" styleClass="status-label" minWidth="-Infinity"/>
        <Button text="Экспорт…" onAction="#onExport" minWidth="-Infinity"/>
    </HBox>
</VBox>
